{
  "name": "@tierspec/mcp-server",
  "version": "0.1.0",
  "description": "AI-driven project management MCP server for hierarchical requirements",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tierspec-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "pretest": "./scripts/check-node-runtime.sh && ./scripts/ensure-node-binaries-executable.sh",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "monitor:4h": "./scripts/monitor-4h.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "project-management",
    "hierarchy",
    "requirements",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/tierspec.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/tierspec/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/tierspec#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0",
    "better-sqlite3": "^11.0.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
